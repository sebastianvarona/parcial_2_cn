            "user_data": "#cloud-config\nhostname: vm-haproxy\nfqdn: vm-haproxy.micro.local\nmanage_etc_hosts: true\nusers:\n  - name: ubuntu\n    ssh_authorized_keys:\n      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIO7y80G4EkdeWjiuud4rU+BdoM8jElAfdx2K14FVB9sP microproyecto-control-node\n    sudo: ['ALL=(ALL) NOPASSWD:ALL']\n    shell: /bin/bash\nssh_pwauth: false\npackage_update: true\nruncmd:\n  - wget -q https://apt.puppet.com/puppet8-release-jammy.deb -O /tmp/puppet8.deb\n  - dpkg -i /tmp/puppet8.deb\n  - apt-get update -y\n  - apt-get install -y puppet-agent\n  - ln -sf /opt/puppetlabs/bin/puppet /usr/local/bin/puppet\n"
          },
