            "network_config": "version: 2\nethernets:\n  ens3:\n    match:\n      macaddress: \"52:54:00:11:22:33\"\n    dhcp4: false\n    addresses:\n      - 192.168.100.3/24\n    routes:\n      - to: default\n        via: 192.168.100.1\n    nameservers:\n      addresses: [8.8.8.8, 1.1.1.1]\n",
